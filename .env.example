# Sentriq environment configuration
# Copy this file to .env and fill in real values.

APP_ENV=review

# Required: cookie signing key, generate with `openssl rand -hex 32`.
# It must not change between restarts, or every session is invalidated.
APP_SECRET_KEY=replace-with-at-least-64-hex-characters

# Database. Postgres only: the app refuses to start without this, and refuses a
# sqlite:// URL. Both schemes work, postgres:// and postgresql://, and are routed
# to psycopg 3. To move an older SQLite database across once:
#   python -m sentriq.manage import-sqlite data/fastapi.sqlite3
DATABASE_URL=postgresql://sentriq:change-me@postgres:5432/sentriq

# Workers. The rate limiter and lockout counters are per worker unless REDIS_URL
# is set, so N workers allow N times the per-client limit.
# WEB_CONCURRENCY=4
# DB_POOL_SIZE=10
# DB_POOL_MAX_OVERFLOW=20

# Keep 0 only for localhost review. Set to 1 behind HTTPS for production.
COOKIE_SECURE=0

# Optional: rate limiting
# RATE_LIMIT_REQUESTS=120
# RATE_LIMIT_WINDOW=60

# Optional: shared rate-limit and lockout counters for multi-worker deployments.
# Without it each worker keeps its own counters, so limits multiply by worker count.
# REDIS_URL=redis://redis:6379/0

# Optional: max evidence upload size in bytes (default: 6 MB)
# MAX_UPLOAD_BYTES=6291456

# Optional: login lockout (default: 5 attempts per address+username, 300s window)
# LOGIN_LOCKOUT_THRESHOLD=5
# LOGIN_LOCKOUT_SECONDS=300

# Optional: timezone used to render timestamps (stored in UTC). Default Asia/Yangon.
# DISPLAY_TIMEZONE=Asia/Yangon

# Optional: per-account lockout across rotating addresses (default: 10)
# LOGIN_ACCOUNT_LOCKOUT_THRESHOLD=10

# Optional: peers allowed to set X-Forwarded-For / X-Real-IP (default: loopback).
# Only list your reverse proxy. Docker compose sets the bridge range for you.
# TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Retention: archive and remove closed tickets older than this many days.
# The job runs on demand (python -m sentriq.manage retention --apply).
# RETENTION_DAYS=730
# ARCHIVE_DIR=data/archive
# AUDIT_EXPORT_DIR=data/audit-exports

# Backup monitoring: /healthz reports degraded when the newest snapshot is older.
# BACKUP_MAX_AGE_HOURS=36
# BACKUP_DIR=/app/backups

# Metrics: unset means /metrics only answers on loopback.
# METRICS_TOKEN=replace-with-a-long-random-string

# Notifications. Each channel stays off until it is configured.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=soc@example.com
# SMTP_PASSWORD=replace-me
# SMTP_STARTTLS=1
# NOTIFY_EMAIL_FROM=soc@example.com
# NOTIFY_EMAIL_TO=soc-team@example.com,oncall@example.com
# NOTIFY_TEAMS_WEBHOOK=https://example.webhook.office.com/webhookb2/...
# NOTIFY_ON_ASSIGN=1
# NOTIFY_ON_ESCALATE=1
# NOTIFY_MIN_SEVERITY=High
# PUBLIC_BASE_URL=https://soc.example.com
