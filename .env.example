# SOC Alert Tracker environment configuration
# Copy this file to .env and fill in real values.

# Required: generate each with `openssl rand -hex 32`
APP_ENV=review
N8N_API_KEY=replace-with-at-least-64-hex-characters

# Required: cookie signing key (must not change between restarts)
APP_SECRET_KEY=replace-with-at-least-64-hex-characters

# Optional: header name for n8n API key (default: X-API-Key)
# N8N_API_HEADER=X-API-Key

# Optional: SQLite database path (default: data/fastapi.sqlite3)
# SQLITE_PATH=data/fastapi.sqlite3

# Keep 0 only for localhost review. Set to 1 behind HTTPS for production.
COOKIE_SECURE=0

# Optional: rate limiting
# RATE_LIMIT_REQUESTS=120
# RATE_LIMIT_WINDOW=60

# Optional: max evidence upload size in bytes (default: 20 MB)
# MAX_UPLOAD_BYTES=20971520

# Optional: login lockout (default: 5 attempts, 300s window)
# LOGIN_LOCKOUT_THRESHOLD=5
# LOGIN_LOCKOUT_SECONDS=300
